{
  "name": "class-break-timer",
  "productName": "课间休息计时",
  "version": "1.0.0",
  "description": "教师课间休息倒计时工具：代码雨动态背景 + 精确秒级倒计时 + 下课铃声",
  "main": "main.js",
  "author": {
    "name": "wuqy"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:win": "electron-builder --win --x64 --publish never",
    "pack:all": "electron-builder -m -w --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wuqy.classbreaktimer",
    "productName": "课间休息计时",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "!dist/**",
      "!node_modules/**",
      "!docs/**",
      "!.github/**",
      "!scripts/**"
    ],
    "artifactName": "ClassBreakTimer-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "课间休息计时 ${version}${arch}",
      "background": "build/dmg-background.png",
      "window": { "width": 660, "height": 400 },
      "contents": [
        { "x": 180, "y": 290, "type": "file" },
        { "x": 480, "y": 290, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    },
    "portable": {
      "artifactName": "ClassBreakTimer-${version}-win-x64-portable.${ext}"
    }
  }
}
